# Salin ke .env untuk pemakaian lokal. File .env di-gitignore. Jangan isi nilai rahasia di file ini.

# --- GCP ---
GCP_PROJECT_ID=
GCP_REGION=asia-southeast2
# owner/repo GitHub, dipakai untuk membatasi Workload Identity Federation
GITHUB_REPO=
# opsional: untuk membuat budget alert via bootstrap_gcp.sh
GCP_BILLING_ACCOUNT_ID=
# email penerima notifikasi alert KPI / sync failure di Google Apps Script (opsional)
ALERT_EMAILS=

# --- OLTP (Neon, project fnb-oltp) ---
# postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SOURCE_DATABASE_URL=

# --- dbt (lokal) ---
# nama dataset dev: dbt_<DBT_USER>_* (misal DBT_USER=sarif -> dbt_sarif_marts)
DBT_USER=
